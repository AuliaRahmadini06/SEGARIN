<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF5DB"
    tools:context=".MainActivity">

    <!-- BAGIAN KIRI: Judul, Subjudul, Tag Buah -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.5">

        <!-- JUDUL: SEGARIN -->
        <LinearLayout
            android:id="@+id/llTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.03"
                android:text="SEGAR"
                android:textColor="#1F3D2B"
                android:textSize="40sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.03"
                android:text="IN"
                android:textColor="#C1442D"
                android:textSize="40sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- SUBJUDUL -->
        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="CEK KESEGARAN BUAH\nLANGSUNG DARI KAMERA HP"
            android:textColor="#222222"
            android:textSize="11sp" />

        <!-- TAG KOTAK BUAH -->
        <LinearLayout
            android:id="@+id/llTags"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="65dp"
                android:layout_height="22dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_tag_dashed"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:layerType="software"
                android:text="MANGGA"
                android:textColor="#222222"
                android:textSize="9sp" />

            <TextView
                android:layout_width="65dp"
                android:layout_height="22dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_tag_dashed"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:layerType="software"
                android:text="PISANG"
                android:textColor="#222222"
                android:textSize="9sp" />

            <TextView
                android:layout_width="65dp"
                android:layout_height="22dp"
                android:background="@drawable/bg_tag_dashed"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:layerType="software"
                android:text="TOMAT"
                android:textColor="#222222"
                android:textSize="9sp" />
        </LinearLayout>

    </LinearLayout>


    <!-- BAGIAN KANAN: Gambar Ilustrasi & Tombol Aksi -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.5">

        <!-- ILUSTRASI GAMBAR FRUITS -->
        <ImageView
            android:id="@+id/ivIllustration"
            android:layout_width="160dp"
            android:layout_height="110dp"
            android:layout_marginBottom="12dp"
            android:contentDescription="Ilustrasi Buah Segar"
            android:src="@drawable/fruits" />

        <!-- TOMBOL MULAI KAMERA -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMulaiKamera"
            android:layout_width="210dp"
            android:layout_height="40dp"
            android:layout_marginBottom="8dp"
            android:fontFamily="sans-serif-condensed"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="MULAI KAMERA"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="#C1442D"
            app:cornerRadius="10dp"
            app:strokeColor="#222222"
            app:strokeWidth="1dp" />

        <!-- TOMBOL PETUNJUK PENGGUNAAN -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPetunjuk"
            android:layout_width="210dp"
            android:layout_height="40dp"
            android:fontFamily="@font/news_cycle_bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="PETUNJUK PENGGUNAAN"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            app:backgroundTint="#2E5A44"
            app:cornerRadius="10dp"
            app:strokeColor="#222222"
            app:strokeWidth="1dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>