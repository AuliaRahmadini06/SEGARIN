<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF5DB"
    tools:context=".MainActivity">

    <!-- JUDUL: SEGARIN -->
    <LinearLayout
        android:id="@+id/llTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="120dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.03"
            android:text="SEGAR"
            android:textColor="#1F3D2B"
            android:textSize="64sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.03"
            android:text="IN"
            android:textColor="#C1442D"
            android:textSize="64sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- SUBJUDUL -->

    <!-- ILUSTRASI GAMBAR FRUITS -->

    <!-- TAG KOTAK BUAH -->

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="CEK KESEGARAN BUAH\nLANGSUNG DARI KAMERA HP"
        android:textColor="#222222"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/llTitle" />

    <ImageView
        android:id="@+id/ivIllustration"
        android:layout_width="260dp"
        android:layout_height="200dp"
        android:layout_marginTop="20dp"
        android:contentDescription="Ilustrasi Buah Segar"
        android:src="@drawable/fruits"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.496"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle" />

    <LinearLayout
        android:id="@+id/llTags"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.494"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivIllustration">

        <TextView
            android:layout_width="73dp"
            android:layout_height="24dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_tag_dashed"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:layerType="software"
            android:text="MANGGA"
            android:textColor="#222222"
            android:textSize="10sp" />

        <TextView
            android:layout_width="73dp"
            android:layout_height="24dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_tag_dashed"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:layerType="software"
            android:text="PISANG"
            android:textColor="#222222"
            android:textSize="10sp" />

        <TextView
            android:layout_width="73dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_tag_dashed"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:layerType="software"
            android:text="TOMAT"
            android:textColor="#222222"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- TOMBOL MULAI KAMERA -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMulaiKamera"
        android:layout_width="252dp"
        android:layout_height="49dp"
        android:layout_marginBottom="8dp"
        android:fontFamily="sans-serif-condensed"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="MULAI KAMERA"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        app:backgroundTint="#C1442D"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toTopOf="@id/btnPetunjuk"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.496"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="#222222"
        app:strokeWidth="1dp" />

    <!-- TOMBOL PETUNJUK PENGGUNAAN -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPetunjuk"
        android:layout_width="252dp"
        android:layout_height="49dp"
        android:layout_marginBottom="96dp"
        android:fontFamily="@font/news_cycle_bold"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="PETUNJUK PENGGUNAAN"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        app:backgroundTint="#2E5A44"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.496"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="#222222"
        app:strokeWidth="1dp" />

</androidx.constraintlayout.widget.ConstraintLayout>